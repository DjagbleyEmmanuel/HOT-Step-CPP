# /etc/hot-step-cpp/hot-step.env
#
# System-wide configuration for HOT-Step CPP. Sourced by /usr/bin/hot-step.
# Edit with sudo, then restart the app.
#
# Because dotenv never overrides a variable that already exists in the
# environment, anything set HERE wins over the app's own settings file
# (/var/lib/hot-step-cpp/.env), which is what the in-app Settings screen
# writes. So only put settings here that the Settings screen should not
# control. Everything else belongs in Settings > Environment.
#
# YOU DO NOT NEED THIS FILE FOR PATHS. The writable directories are already
# symlinked from /opt/hot-step-cpp into /var/lib/hot-step-cpp, so the app's
# own defaults (./data, ./models, ./adapters) already resolve to writable
# locations and stay editable in the Settings screen.
#
# ── Model weights ───────────────────────────────────────────────────────
# The app looks for .gguf files in ./models. To use a folder of weights that
# already exists elsewhere on disk - a shared library, an external drive, an
# NTFS partition - point it here, or set it in Settings > Environment.
#
# Either works; this file wins over the Settings screen. Quote the value if the
# path contains spaces - or not, the launcher parses this file itself and
# handles spaces either way.
#
#   ACESTEPCPP_MODELS="/media/ghost/Pride/AceStep Music Models"
#
# The engine rescans this folder on startup, so restart after changing it.
# It only needs read access to the weights; the Model Manager's downloads go
# to the folder above, so give the path write access if you want to download
# into it.
#
# ACESTEPCPP_ADAPTERS works the same way for LoRA / LoKr adapters.
# ACESTEPCPP_ADAPTERS=/var/lib/hot-step-cpp/adapters

# ── Bind addresses ──────────────────────────────────────────────────────
# Neither of these is reachable from the Settings screen, and both are set to
# loopback deliberately.
#
# The web server has no authentication and will drive your GPU, so it must not
# answer on your whole network unless you understand that. Change SERVER_HOST
# to 0.0.0.0 only if you deliberately want other machines to reach it.
SERVER_HOST=127.0.0.1

# The engine speaks raw model control with no authentication either, and is
# only ever meant to be driven by the web server next to it. Leave this on
# loopback.
ACESTEPCPP_HOST=127.0.0.1

# Ports. These ARE editable in Settings > Environment; they are listed here
# for reference only, and left commented out so the app keeps control.
# SERVER_PORT=3001
# ACESTEPCPP_PORT=8085