# HOT-Step CPP - user settings
#
# This file is created automatically from this template the first time the app
# starts, at /var/lib/hot-step-cpp/.env. The Settings screen in the app edits
# that copy, not this one.
#
# Derived from the project's .env.example. Two changes:
#   * DATA_DIR and LYRICS_EXPORT_DIR are commented out. They are set by
#     /etc/hot-step-cpp/hot-step.env, which is where a Debian install keeps
#     writable state (/var/lib/hot-step-cpp) instead of inside /opt.
#   * SERVER_HOST defaults to loopback. The server has no authentication, so it
#     should not listen on your whole network by default.
#
# System-wide configuration:  /etc/hot-step-cpp/hot-step.env
# Everything below is yours to change; the app reloads it on restart.

# ace-server executable
# Default: <install prefix>/engine/ace-server
# ACESTEPCPP_EXE=/opt/hot-step-cpp/engine/ace-server

# Model directory (GGUF files)
# Default: /var/lib/hot-step-cpp/models (set in /etc/hot-step-cpp/hot-step.env)
# ACESTEPCPP_MODELS=/var/lib/hot-step-cpp/models

# Adapter directory (LoRA safetensors)
# Default: /var/lib/hot-step-cpp/adapters (set in /etc/hot-step-cpp/hot-step.env)
# ACESTEPCPP_ADAPTERS=/var/lib/hot-step-cpp/adapters

# ace-server network settings (rarely need changing)
ACESTEPCPP_PORT=8085
ACESTEPCPP_HOST=127.0.0.1

# Node.js server
SERVER_PORT=3001
SERVER_HOST=127.0.0.1
# DATA_DIR=/var/lib/hot-step-cpp/data

# -----------------------------------------------------------------------------
# Lyric Studio (Lireek) Integration
# -----------------------------------------------------------------------------

# Genius API
GENIUS_ACCESS_TOKEN=

# LLM Providers (at least one required for Lyric Studio)
DEFAULT_LLM_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Local LLM Providers
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_MODEL=
UNSLOTH_BASE_URL=http://127.0.0.1:8888
UNSLOTH_USERNAME=
UNSLOTH_PASSWORD=
UNSLOTH_MODEL=

# llama.cpp server (llama-server / llama-cli --server)
LLAMACPP_BASE_URL=http://127.0.0.1:8080/v1
LLAMACPP_MODEL=

# Generic OpenAI-compatible endpoint (oMLX, vLLM, LocalAI, etc.)
# Only appears in the UI when BASE_URL is set.
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=
OPENAI_COMPAT_NAME=OpenAI Compatible

# Models to use
GEMINI_MODEL=gemini-2.5-flash
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Storage
# Default: /var/lib/hot-step-cpp/data/lyrics (set in /etc/hot-step-cpp/hot-step.env)
# LYRICS_EXPORT_DIR=/var/lib/hot-step-cpp/data/lyrics

# Dataset Studio labeling throughput
# concurrency = calls in flight; min interval = spacing between call STARTS.
# Defaults are the old serial-with-courtesy-sleep behaviour. Caption concurrency
# is the biggest speed lever (audio-grounded captions take 5-15s each) but
# multiplies requests-per-minute against your provider quota - raise carefully.
LABEL_ESSENTIA_CONCURRENCY=2
LABEL_GENIUS_CONCURRENCY=1
LABEL_GENIUS_MIN_INTERVAL_MS=400
LABEL_CAPTION_CONCURRENCY=1
LABEL_CAPTION_MIN_INTERVAL_MS=250

# Post-processing stem cache
# StableStep needs a vocal/instrumental split, and the chain always splits the
# RAW render - so running the chain again over the same track (listen, tweak,
# run again) would redo identical GPU work. Cached stems are reused instead,
# keyed by the audio's own hash. Stems are f32: ~42 MB per minute of audio per
# track. 0 turns the cache off.
PP_STEM_CACHE_GB=4